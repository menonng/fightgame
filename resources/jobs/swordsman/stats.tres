passive_name = "리바이브 트릭컬"
passive_desc = "굉장히 신성해보이는 검을 소환합니다. 처음엔 느리게, 이후 급격히 가속하며 낙하합니다. 첫 타격 시 최대 체력의 10%를 깎고 10초간 지속 피해를 남깁니다. 발동 직후 1초간 이속이 2배가 됩니다."
q_name = "나타드코코"
q_desc = "5초간 공격력이 크게 상승하지만 이속과 공속이 느려집니다. 이 상태의 기본 공격은 방어를 무시하는 고정 피해를 줍니다."
e_name = "매지컬플레임초울트라비저블스워드나이트"
e_desc = "굉장히 신성해보이는 검을 소환합니다. 처음엔 느리게, 이후 급격히 가속하며 낙하합니다. 첫 타격 시 최대 체력의 10%를 깎고 10초간 지속 피해를 남깁니다. 발동 직후 1초간 이속이 2배가 됩니다."
r_name = "돌려 돌려 돌림판"
r_desc = "5초간 고속 회전합니다. 이속 증가, 받는 피해 40% 감소. 인접한 적에게 0.5초마다 피해를 입힙니다."
